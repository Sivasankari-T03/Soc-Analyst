# LabTrace SOC Configuration
PORT=3000
LABTRACE_API_KEY=labtrace-secret-key

# Safety Guardrail: Set to true only in production Active Directory / EDR environments
# When false (default), playbook containment actions are securely recorded in the cryptographic audit ledger
# and simulated safely without modifying host Active Directory accounts or local firewalls.
EXECUTE_REAL_ACTIONS=false

# Optional Threat Intelligence API Keys (Enrichment has built-in offline intelligence without these)
# ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
# GREYNOISE_API_KEY=your_greynoise_api_key_here

# Optional Incident Webhook (Slack, Jira, Teams, Discord)
# WEBHOOK_URL=https://hooks.slack.com/services/...
